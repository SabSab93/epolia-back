NODE_ENV=development
PORT=3000
JSON_BODY_LIMIT=1mb

# Local PostgreSQL Docker database.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/epolia?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/epolia?schema=public"

# Supabase note:
# - DATABASE_URL can use the pooled connection URL.
# - DIRECT_URL must use the direct connection URL for migrations.

# Comma-separated browser origins allowed by CORS.
# Production must use known HTTPS origins, not "*".
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Local placeholder only. Use a real secret outside the repository in production.
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=1h

# Set to the published terms of use version shown to people signing up.
# Public registration is unavailable while this value is empty.
REGISTRATION_TERMS_VERSION=

# Public URL of this API, used in links sent by e-mail (no trailing slash).
PUBLIC_API_URL=http://localhost:3000

# Resend (https://resend.com). Keep the key outside the repository.
# Without RESEND_API_KEY and EMAIL_FROM, no e-mail is sent and the API says so.
RESEND_API_KEY=
EMAIL_FROM="Epolia <no-reply@example.com>"

# Address of the mobile app opened by the button on the e-mail confirmation page.
# Must match the URL scheme declared in the Capacitor app. Empty: no button.
APP_RETURN_URL=epolia://email-verified
